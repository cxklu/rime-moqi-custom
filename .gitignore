# ── Rime 运行时生成物 ───────────────────────────────────────────
# 部署（编译）输出
/build/
# 安装信息，含 installation_id，属于个人设备标识，不应公开
/installation.yaml
# 用户在 Rime 界面里切换过的开关状态
/user.yaml
# 同步目录
/sync/

# ── 用户词典 / 学习数据 ─────────────────────────────────────────
# 本配置为「完全固定词频」，不接受自动学习与调频，
# 以下文件全部是 Rime 运行时产物，一律不入库。
*.userdb/
*.userdb.old/
# tabledb 形式的用户词典文本（user_dict: user.custom.dict 产生）
/user.custom.dict.txt

# ── Rime 编译后的二进制 ─────────────────────────────────────────
# 词典、反查词典的编译结果
*.bin
*.reverse.bin
# opencc 编译结果（源数据 opencc/*.txt 需保留，不要一起忽略）
*.ocd2

# 注意：*.gram（zh-moqi.gram / zhs-moqi.gram）是八股文语言模型的源文件，务必入库，不要加入忽略

# ── Syncthing ──────────────────────────────────────────────────
.stfolder/
.stversions/
# 防止 Syncthing 把 .git 同步到手机端（对 git 本身无效，git 永不跟踪自身目录）
.git/

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── 备份 ───────────────────────────────────────────────────────
# Rime词库排序.py 写回前自动生成的备份
*.bak

# ── 系统 / 编辑器垃圾 ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~
*.swp
*.swo
.idea/
.vscode/
